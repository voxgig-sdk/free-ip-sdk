  }

  name: "json"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/json"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/json"
          s: [
            {
              lit: "api"
            }
            {
              lit: "json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/json"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/json"
          s: [
            {
              lit: "api"
            }
            {
              lit: "json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/json/{ipAddress}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "193.247.239.168"
                k: "param"
                n: "id"
                or: "ip_address"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/json/{ipAddress}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              ipAddress: "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "json"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



