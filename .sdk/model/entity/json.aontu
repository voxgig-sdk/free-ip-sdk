      t: "`$ARRAY`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: false
      sh: "Currency information for the country"
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    ip: {
      h: "Ip"
      n: "ip"
      r: false
      sh: "IPv4 or IPv6 address to lookup"
      t: "`$STRING`"
    }
    ipAddress: {
      h: "Ip Address"
      n: "ipAddress"
      r: false
      sh: "The IP address that was looked up"
      t: "`$STRING`"
    }
    ipVersion: {
      h: "Ip Version"
      n: "ipVersion"
      r: false
      sh: "IP version (4 for IPv4, 6 for IPv6)"
      t: "`$INTEGER`"
    }
    isProxy: {
      h: "Is Proxy"
      n: "isProxy"
      r: false
