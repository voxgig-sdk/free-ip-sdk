      req: false
      type: "`$ARRAY`"
    }
    {
      name: "zip_code"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "json"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/json"
          parts: [
            "api"
            "json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/json"
          parts: [
            "api"
            "json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "193.247.239.168"
                kind: "param"
                name: "id"
                orig: "ip_address"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/json/{ipAddress}"
          parts: [
            "api"
            "json"
            "{id}"
          ]
          rename: {
            param: {
              ipAddress: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
