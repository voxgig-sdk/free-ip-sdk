# Entity: json

main: kit: entity: json: {

  alias: field: {}

  fields: {
    asn: {
      h: "Asn"
      n: "asn"
      r: false
      sh: "Autonomous System Number"
      t: "`$STRING`"
    }
    asnOrganization: {
      h: "Asn Organization"
      n: "asnOrganization"
      r: false
      sh: "Organization associated with the ASN"
      t: "`$STRING`"
    }
